# ==============================================================================
# EXEMPLO DE CONFIGURAÇÃO LOCAL (.env.example)
# ==============================================================================
# Copie este arquivo para ".env" na raiz do projeto e preencha com os dados
# reais do seu ambiente. O arquivo ".env" é ignorado pelo Git (.gitignore).
#
# Listas (campos type: array nos formulários YAML) usam "|" como separador.
# ==============================================================================

# --- Atendimento / Equipe STI ---
STI_RAMAL="0000, 0001 ou 0002"
STI_CENTRAL_FONE="(00) 0000-0000 | Opção => 2"
STI_WHATSAPP_FUNCIONAL="00 90000-0000"
STI_PORTAL_SERVICOS_URL="https://portal.exemplo.gov.br"

# --- Transporte Urbano (:transporte) ---
STI_LOCAIS_URBANOS="Sede Principal|Anexo I|Unidade Centro"
STI_LOCAIS_ARTIGOS="sede principal=a Sede Principal|anexo i=o Anexo I|unidade centro=a Unidade Centro"
STI_PASSAGEIROS_URBANOS="Servidor Exemplo 1|Servidor Exemplo 2|Terceirizado Exemplo 1"

# --- Transporte Intermunicipal (:viagem) e Diárias (:diaria) ---
STI_DESTINOS_PADRAO="Cidade A|Cidade B"
STI_PASSAGEIROS_VIAGEM="Servidor Exemplo 1|Servidor Exemplo 2|Terceirizado Exemplo 1"
STI_TERCEIRIZADOS_DIARIA="Terceirizado Exemplo 1|Terceirizado Exemplo 2"
STI_EMPRESA_TERCEIRIZADA="Empresa Terceirizada"
STI_DEMANDAS_PADRAO="Viagem"

# --- Transporte de Material (:transdevo) ---
STI_ITENS_DEVOLUCAO_PADRAO="Computador Desktop - Patrimônio: |Monitor 24\" - Patrimônio: "

# --- Scripts Administrativos (:analisar / :limpar / :deluser) ---
STI_ADMIN_OUTPUT_FOLDER="C:\\get-computer-info"

# --- Sincronização de Perfis Kando (master_fix_kando.py) ---
STI_KNOWN_USERS="usuario_trabalho|usuario_admin|User"
